# 构建产物/临时文件(仅忽略真正的一次性产物, 不影响仓库内 vendored 源码与设备树)
# 注意: 不要加 *.img / *.ko / *.zip / Image / *.symvers —— 设备树与产物目录里确有这些文件
/out/
/build-logs/
/susfs-patch/
/patch-rejects/
kernel_workspace/
*.rej
*.tmp
__pycache__/
*.py[cod]
# IDE/OS 规则只作用于仓库根, 不能递归影响 vendored 源码(上游 kernelsu/kernel/.vscode 里有文件)
/.vs/
/.idea/
/.vscode/
/.DS_Store
/Thumbs.db
